<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>MAYA · System</title>
  <style>
    /* ---------- GLOBAL / RESET ---------- */
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', 'Inter', system-ui, -apple-system, sans-serif; }
    :root {
      --bg-deep: #0a0c14;
      --bg-panel: #11141f;
      --bg-card: #161b2b;
      --border-dim: #2a3147;
      --border-glow: #2f6bff;
      --blue: #2f6bff;
      --blue-soft: #5a8aff;
      --gold: #f5c542;
      --gold-dim: #b8952e;
      --text-main: #e8ecf5;
      --text-dim: #8b95b0;
      --danger: #ff4d6d;
      --success: #3dd68c;
      --radius: 14px;
      --sidebar-w: 72px;
      --orb-size: 140px;
    }
    body {
      background: var(--bg-deep);
      color: var(--text-main);
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    /* subtle system glow */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at 20% 10%, rgba(47,107,255,0.08), transparent 60%),
                  radial-gradient(circle at 80% 90%, rgba(245,197,66,0.05), transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    /* ---------- HEADER ---------- */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 18px;
      background: rgba(10,12,20,0.92);
      border-bottom: 1px solid var(--border-dim);
      backdrop-filter: blur(8px);
      z-index: 20;
      flex-shrink: 0;
      min-height: 54px;
    }
    .header-left { display: flex; align-items: center; gap: 14px; }
    .bell-btn {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      color: var(--text-main);
      width: 38px; height: 38px;
      border-radius: 50%;
      display: grid; place-items: center;
      cursor: pointer;
      font-size: 18px;
      transition: border-color 0.2s;
    }
    .bell-btn:hover { border-color: var(--blue); }
    .bell-badge {
      position: absolute; top: -3px; right: -3px;
      background: var(--gold);
      color: #0a0c14;
      font-size: 10px; font-weight: 800;
      min-width: 17px; height: 17px;
      border-radius: 10px;
      display: grid; place-items: center;
      padding: 0 4px;
    }
    .clock {
      font-variant-numeric: tabular-nums;
      font-size: 15px;
      letter-spacing: 0.5px;
      color: var(--text-dim);
    }
    .clock strong { color: var(--gold); font-weight: 600; }
    .header-title {
      font-size: 15px; font-weight: 700;
      letter-spacing: 3px;
      color: var(--blue-soft);
      text-transform: uppercase;
    }
    .header-right { display: flex; align-items: center; gap: 18px; }
    .xp-bar-wrap {
      display: flex; align-items: center; gap: 8px;
      font-size: 11px; color: var(--text-dim);
    }
    .xp-track {
      width: 110px; height: 6px;
      background: #1e2436;
      border-radius: 6px;
      overflow: hidden;
    }
    .xp-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--blue), var(--gold));
      width: 0%;
      transition: width 0.4s;
    }
    .level-badge {
      font-size: 12px; font-weight: 700;
      color: var(--gold);
      border: 1px solid var(--gold-dim);
      padding: 3px 10px;
      border-radius: 20px;
      white-space: nowrap;
    }
    .header-name { font-size: 13px; color: var(--text-dim); }

    /* ---------- LAYOUT ---------- */
    .app-body {
      display: flex;
      flex: 1;
      overflow: hidden;
      position: relative;
      z-index: 1;
    }

    /* ---------- SIDEBAR ---------- */
    .sidebar {
      width: var(--sidebar-w);
      background: rgba(10,12,20,0.85);
      border-right: 1px solid var(--border-dim);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px 0;
      gap: 6px;
      flex-shrink: 0;
      overflow-y: auto;
      z-index: 15;
    }
    .nav-btn {
      width: 52px; height: 48px;
      border-radius: 12px;
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-dim);
      font-size: 18px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      cursor: pointer;
      transition: all 0.15s;
      gap: 2px;
    }
    .nav-btn .nav-label { font-size: 7px; letter-spacing: 0.5px; text-transform: uppercase; }
    .nav-btn:hover { background: var(--bg-card); color: var(--text-main); }
    .nav-btn.active {
      background: linear-gradient(135deg, rgba(47,107,255,0.18), rgba(245,197,66,0.08));
      border-color: var(--blue);
      color: var(--gold);
      box-shadow: 0 0 12px rgba(47,107,255,0.15);
    }

    /* ---------- MAIN CONTENT ---------- */
    .main-content {
      flex: 1;
      overflow-y: auto;
      padding: 18px 22px 40px;
      position: relative;
    }
    .page { display: none; animation: fadeIn 0.25s; }
    .page.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    .page-title {
      font-size: 20px; font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 16px;
      color: var(--blue-soft);
      display: flex; align-items: center; gap: 10px;
    }
    .page-title .gold-dot { width: 8px; height: 8px; background: var(--gold); border-radius: 50%; }

    /* ---------- CARDS / BOXES ---------- */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius);
      padding: 16px;
      margin-bottom: 14px;
      position: relative;
    }
    .card h3 { font-size: 14px; color: var(--gold); margin-bottom: 10px; letter-spacing: 0.5px; }
    .card p { font-size: 13px; color: var(--text-dim); line-height: 1.5; }

    /* ---------- BUTTONS ---------- */
    .btn {
      background: var(--bg-panel);
      border: 1px solid var(--border-dim);
      color: var(--text-main);
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      transition: all 0.15s;
      letter-spacing: 0.3px;
    }
    .btn:hover { border-color: var(--blue); color: var(--blue-soft); }
    .btn-primary {
      background: linear-gradient(135deg, var(--blue), #1e4fd0);
      border-color: var(--blue);
      color: #fff;
    }
    .btn-primary:hover { filter: brightness(1.15); color: #fff; }
    .btn-gold {
      background: linear-gradient(135deg, var(--gold-dim), #8a6d1f);
      border-color: var(--gold);
      color: #0a0c14;
    }
    .btn-gold:hover { filter: brightness(1.15); color: #0a0c14; }
    .btn-sm { padding: 5px 10px; font-size: 11px; border-radius: 6px; }
    .btn-danger { border-color: var(--danger); color: var(--danger); }
    .btn-danger:hover { background: rgba(255,77,109,0.12); }

    /* ---------- FORMS ---------- */
    .field { margin-bottom: 10px; }
    .field label {
      display: block;
      font-size: 11px;
      color: var(--text-dim);
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .field input, .field select, .field textarea {
      width: 100%;
      background: var(--bg-panel);
      border: 1px solid var(--border-dim);
      border-radius: 8px;
      padding: 9px 12px;
      color: var(--text-main);
      font-size: 13px;
      outline: none;
      transition: border-color 0.15s;
    }
    .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--blue); }
    .field .hint { font-size: 10px; color: var(--text-dim); margin-top: 3px; }
    .form-row { display: flex; gap: 10px; flex-wrap: wrap; }
    .form-row > * { flex: 1; min-width: 120px; }

    /* ---------- LISTS ---------- */
    .list-item {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--bg-panel);
      border: 1px solid var(--border-dim);
      border-radius: 8px;
      padding: 9px 12px;
      margin-bottom: 7px;
      font-size: 13px;
      gap: 8px;
    }
    .list-item .meta { color: var(--text-dim); font-size: 11px; }
    .empty-msg { color: var(--text-dim); font-size: 12px; font-style: italic; padding: 8px 0; }

    /* ---------- NOTIFICATION PANEL ---------- */
    .notif-panel {
      position: fixed;
      top: 60px; left: 12px;
      width: 320px;
      max-height: 70vh;
      overflow-y: auto;
      background: var(--bg-panel);
      border: 1px solid var(--blue);
      border-radius: var(--radius);
      padding: 14px;
      z-index: 100;
      box-shadow: 0 10px 40px rgba(0,0,0,0.6);
      display: none;
    }
    .notif-panel.open { display: block; }
    .notif-panel h4 { font-size: 12px; color: var(--gold); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px; }
    .notif-item {
      padding: 7px 0;
      border-bottom: 1px solid var(--border-dim);
      font-size: 12px;
      color: var(--text-dim);
    }
    .notif-item:last-child { border-bottom: none; }
    .notif-item strong { color: var(--text-main); display: block; margin-bottom: 2px; }

    /* ---------- ORB ---------- */
    .orb-container {
      position: fixed;
      right: 22px; bottom: 22px;
      width: var(--orb-size);
      height: var(--orb-size);
      z-index: 50;
      cursor: grab;
      touch-action: none;
      user-select: none;
      transition: width 0.2s, height 0.2s;
    }
    .orb-container:active { cursor: grabbing; }
    .orb-core {
      width: 100%; height: 100%;
      border-radius: 50%;
      position: relative;
      display: grid; place-items: center;
      transition: transform 0.1s;
    }
    .orb-dots {
      position: absolute; inset: 0;
      border-radius: 50%;
      background:
        radial-gradient(circle at 30% 30%, rgba(47,107,255,0.25), transparent 60%),
        radial-gradient(circle at 70% 70%, rgba(245,197,66,0.15), transparent 60%);
      box-shadow: 0 0 40px rgba(47,107,255,0.25), inset 0 0 30px rgba(47,107,255,0.15);
    }
    .orb-dots::before {
      content: '';
      position: absolute; inset: 12%;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(47,107,255,0.35), transparent 70%);
      animation: pulse 3s infinite ease-in-out;
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 0.7; }
      50% { transform: scale(1.06); opacity: 1; }
    }
    .orb-glow {
      width: 38%; height: 38%;
      border-radius: 50%;
      background: radial-gradient(circle, var(--blue-soft), var(--blue) 50%, transparent 75%);
      box-shadow: 0 0 30px var(--blue), 0 0 60px rgba(47,107,255,0.5);
      animation: pulse 2s infinite ease-in-out;
      position: relative;
    }
    .orb-container.speaking .orb-glow { animation: vibrate 0.08s infinite; }
    @keyframes vibrate {
      0% { transform: translate(0,0) scale(1.02); }
      25% { transform: translate(-2px,1px) scale(1.02); }
      50% { transform: translate(2px,-1px) scale(1.04); }
      75% { transform: translate(-1px,-2px) scale(1.02); }
      100% { transform: translate(0,0) scale(1.02); }
    }
    .orb-caption {
      position: fixed;
      bottom: calc(22px + var(--orb-size) + 6px);
      right: 22px;
      max-width: 280px;
      background: rgba(17,20,31,0.95);
      border: 1px solid var(--blue);
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 12px;
      color: var(--text-main);
      z-index: 51;
      display: none;
      text-align: right;
      line-height: 1.4;
    }
    .orb-caption.show { display: block; }

    /* Big orb on Maya page */
    .maya-page {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 60vh;
      gap: 20px;
      position: relative;
    }
    .maya-orb-big {
      width: 220px; height: 220px;
      position: relative;
      cursor: grab;
      touch-action: none;
      user-select: none;
    }
    .maya-orb-big .orb-glow { width: 34%; height: 34%; }
    .maya-reply {
      min-height: 40px;
      max-width: 500px;
      text-align: center;
      font-size: 15px;
      color: var(--gold);
      font-style: italic;
      padding: 0 20px;
      line-height: 1.5;
    }
    .maya-controls { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
    .conversation-box {
      width: 100%;
      max-width: 600px;
      max-height: 220px;
      overflow-y: auto;
      background: var(--bg-panel);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius);
      padding: 12px;
      margin-top: 10px;
      display: none;
      font-size: 13px;
    }
    .conversation-box.show { display: block; }
    .conversation-box .msg { padding: 5px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .conversation-box .msg.user { color: var(--blue-soft); }
    .conversation-box .msg.maya { color: var(--gold); }

    /* ---------- MISC ---------- */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 700px) {
      .grid-2 { grid-template-columns: 1fr; }
      .header-right .header-name, .header-right .xp-bar-wrap span { display: none; }
      .xp-track { width: 60px; }
      .main-content { padding: 12px 12px 30px; }
      :root { --sidebar-w: 60px; --orb-size: 100px; }
      .nav-btn { width: 44px; height: 42px; font-size: 16px; }
      .notif-panel { width: calc(100vw - 24px); left: 12px; }
    }
    .toast {
      position: fixed;
      bottom: 30px; left: 50%;
      transform: translateX(-50%) translateY(80px);
      background: var(--bg-card);
      border: 1px solid var(--gold);
      color: var(--gold);
      padding: 10px 22px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 600;
      z-index: 300;
      opacity: 0;
      transition: all 0.35s;
      pointer-events: none;
      box-shadow: 0 6px 30px rgba(0,0,0,0.5);
      text-align: center;
      max-width: 90vw;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .warn-box {
      background: rgba(255,77,109,0.1);
      border: 1px solid var(--danger);
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 12px;
      color: var(--danger);
      margin: 8px 0;
    }
    .badge { display: inline-block; font-size: 10px; padding: 2px 7px; border-radius: 10px; background: var(--bg-panel); border: 1px solid var(--border-dim); color: var(--text-dim); margin-left: 6px; }
    .badge.gold { border-color: var(--gold-dim); color: var(--gold); }
    .badge.blue { border-color: var(--blue); color: var(--blue-soft); }

    /* scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border-dim); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--blue); }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="header">
    <div class="header-left">
      <button class="bell-btn" id="bellBtn" aria-label="Notifications">
        🔔 <span class="bell-badge" id="bellBadge">0</span>
      </button>
      <div class="clock" id="liveClock">--:--:--</div>
    </div>
    <div class="header-title">MAYA · System</div>
    <div class="header-right">
      <div class="xp-bar-wrap">
        <span>XP</span>
        <div class="xp-track"><div class="xp-fill" id="xpFill"></div></div>
        <span id="xpText">0/100</span>
      </div>
      <div class="level-badge" id="levelBadge">Lv.1</div>
      <div class="header-name">Uday Adhitya</div>
    </div>
  </header>

  <!-- NOTIFICATION PANEL -->
  <div class="notif-panel" id="notifPanel">
    <h4>⏰ Reminders & Timers</h4>
    <div id="notifReminders"><div class="empty-msg">Nothing scheduled.</div></div>
    <h4 style="margin-top:12px;">📜 Notification Log</h4>
    <div id="notifLog"><div class="empty-msg">No notifications yet.</div></div>
    <h4 style="margin-top:12px;">💡 Maya's Suggestions</h4>
    <div id="notifSuggestions"><div class="empty-msg">No suggestions.</div></div>
  </div>

  <!-- APP BODY -->
  <div class="app-body">
    <!-- SIDEBAR -->
    <nav class="sidebar" id="sidebar">
      <button class="nav-btn active" data-page="status" title="Status">📊<span class="nav-label">Status</span></button>
      <button class="nav-btn" data-page="maya" title="Maya">🔮<span class="nav-label">Maya</span></button>
      <button class="nav-btn" data-page="study" title="Study">📚<span class="nav-label">Study</span></button>
      <button class="nav-btn" data-page="sleep" title="Sleep">🌙<span class="nav-label">Sleep</span></button>
      <button class="nav-btn" data-page="exercise" title="Exercise">🏋️<span class="nav-label">Exercise</span></button>
      <button class="nav-btn" data-page="calm" title="Calm">🧘<span class="nav-label">Calm</span></button>
      <button class="nav-btn" data-page="music" title="Music">🎵<span class="nav-label">Music</span></button>
      <button class="nav-btn" data-page="maps" title="Maps">🗺️<span class="nav-label">Maps</span></button>
      <button class="nav-btn" data-page="startup" title="Startup">🚀<span class="nav-label">Startup</span></button>
      <button class="nav-btn" data-page="amicus" title="Amicus">🤝<span class="nav-label">Amicus</span></button>
      <button class="nav-btn" data-page="equity" title="Equity">📈<span class="nav-label">Equity</span></button>
      <button class="nav-btn" data-page="remind" title="Remind">⏱️<span class="nav-label">Remind</span></button>
      <button class="nav-btn" data-page="memory" title="Memory">🧠<span class="nav-label">Memory</span></button>
      <button class="nav-btn" data-page="system" title="System">⚙️<span class="nav-label">System</span></button>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="main-content" id="mainContent">

      <!-- ================= STATUS ================= -->
      <section class="page active" id="page-status">
        <div class="page-title"><span class="gold-dot"></span> Status · Daily Quests</div>
        <div class="card" id="briefingCard">
          <h3>🌅 Briefing</h3>
          <p id="briefingText">Good day, Uday. The System awaits your commands.</p>
        </div>
        <div class="card">
          <h3>📋 Daily Quests</h3>
          <p style="font-size:12px;margin-bottom:10px;">Tick once you've saved the details for that quest.</p>
          <div id="questList"></div>
        </div>
        <div class="card">
          <h3>📝 Quick Note</h3>
          <div class="field">
            <label>Daily intention</label>
            <input id="dailyIntention" placeholder="e.g. Finish 2 lectures of Audit" />
          </div>
          <button class="btn btn-primary" onclick="saveIntention()">Save Intention</button>
          <div id="intentionSaved" style="font-size:12px;color:var(--success);margin-top:8px;"></div>
        </div>
      </section>

      <!-- ================= MAYA ================= -->
      <section class="page" id="page-maya">
        <div class="maya-page">
          <div class="maya-orb-big" id="mayaOrbBig">
            <div class="orb-core">
              <div class="orb-dots"></div>
              <div class="orb-glow"></div>
            </div>
          </div>
          <div class="maya-reply" id="mayaReply">Tap the orb to speak. Double-tap for hands-free.</div>
          <div class="maya-controls">
            <button class="btn btn-primary" id="pttBtn">🎤 Push to Talk</button>
            <button class="btn" id="showConvBtn">Show conversation</button>
            <button class="btn" id="handsFreeBtn">🤖 Hands-free: OFF</button>
          </div>
          <div class="conversation-box" id="conversationBox"></div>
        </div>
      </section>

      <!-- ================= STUDY ================= -->
      <section class="page" id="page-study">
        <div class="page-title"><span class="gold-dot"></span> Study · CA Inter</div>
        <div class="card">
          <h3>📚 Subject Tracker</h3>
          <div class="form-row">
            <div class="field" style="flex:2;"><label>Subject</label><input id="studySubject" placeholder="e.g. Advanced Accounting" /></div>
            <div class="field" style="flex:1;"><label>Hours</label><input id="studyHours" type="number" step="0.5" placeholder="2.5" /></div>
          </div>
          <div class="field"><label>Weak Area (optional)</label><input id="studyWeak" placeholder="e.g. Consolidation" /></div>
          <button class="btn btn-primary" onclick="saveStudy()">+ Add Study Log</button>
          <div id="studyWarn" class="warn-box" style="display:none;"></div>
        </div>
        <div class="card">
          <h3>📊 Logged Hours</h3>
          <div id="studyList"></div>
        </div>
      </section>

      <!-- ================= SLEEP ================= -->
      <section class="page" id="page-sleep">
        <div class="page-title"><span class="gold-dot"></span> Sleep</div>
        <div class="card">
          <h3>🌙 Sleep Log</h3>
          <div class="form-row">
            <div class="field"><label>Date</label><input id="sleepDate" type="date" /></div>
            <div class="field"><label>Hours</label><input id="sleepHours" type="number" step="0.5" placeholder="7.5" /></div>
          </div>
          <div class="field"><label>Quality (1-5)</label><input id="sleepQuality" type="number" min="1" max="5" placeholder="4" /></div>
          <button class="btn btn-primary" onclick="saveSleep()">+ Log Sleep</button>
          <div id="sleepWarn" class="warn-box" style="display:none;"></div>
        </div>
        <div class="card"><h3>📊 Sleep History</h3><div id="sleepList"></div></div>
      </section>

      <!-- ================= EXERCISE ================= -->
      <section class="page" id="page-exercise">
        <div class="page-title"><span class="gold-dot"></span> Exercise · Basic</div>
        <div class="card">
          <h3>🏋️ Log Exercise</h3>
          <div class="field"><label>Exercise</label>
            <select id="exSelect">
              <option>Push-ups</option><option>Squats</option><option>Plank</option>
