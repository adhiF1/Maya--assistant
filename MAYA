    // ---------- COMMAND ENGINE ----------
    function handleCommand(raw) {
      const cmd = raw.toLowerCase().trim();
      let reply = '';
      // hands-free wake
      if (cmd.includes('hey maya')) {
        reply = 'Yes boss.';
        speakReply(reply);
        if (handsFree) startContinuousRecognition();
        return;
      }
      // open pages
      const pageMap = { music: 'music', study: 'study', sleep: 'sleep', exercise: 'exercise', calm: 'calm', maps: 'maps', startup: 'startup', amicus: 'amicus', equity: 'equity', remind: 'remind', memory: 'memory', system: 'system', status: 'status' };
      for (const [key, page] of Object.entries(pageMap)) {
        if (cmd.includes('open ' + key)) {
          reply = `Opening ${key}.`;
          document.querySelector(`.nav-btn[data-page="${page}"]`).click();
          speakReply(reply); return;
        }
      }
      // remember
      const remMatch = cmd.match(/remember\s+(?:that\s+)?(.+)/);
      if (remMatch) {
        const content = remMatch[1];
        const forbidden = /(password|card\s*number|cvv|otp|pin\b)/i;
        if (forbidden.test(content)) { speakReply('I refuse to store passwords, card numbers or OTPs.'); return; }
        memories.push({ type: 'fact', content });
        LS.set('memories', memories); renderMemories();
        speakReply(`Remembered: ${content}`); return;
      }
      // timer
      const timerMatch = cmd.match(/set a timer\s+(?:for\s+)?(\d+)\s*(second|sec|minute|min|hour|hr)s?/);
      if (timerMatch) {
        let n = parseInt(timerMatch[1]);
        const unit = timerMatch[2];
        let ms = n * 1000;
        if (unit.startsWith('min')) ms = n * 60000;
        if (unit.startsWith('hour') || unit.startsWith('hr')) ms = n * 3600000;
        const msg = `Timer for ${n} ${unit}s`;
        reminders.push({ msg, when: `in ${n} ${unit}s` });
        LS.set('reminders', reminders); renderReminders();
        setTimeout(() => pushNotification(`⏰ ${msg}`), ms);
        speakReply(`Timer set for ${n} ${unit}s.`); return;
      }
      // time
      if (cmd.includes('what time is it')) {
        const now = new Date();
        speakReply(`It is ${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}.`);
        return;
      }
      // save contact
      const contactMatch = cmd.match(/save contact\s+(\w+)\s+([\d\s]+)/);
      if (contactMatch) {
        const name = contactMatch[1];
        const phone = contactMatch[2].replace(/\s/g, '');
        addresses.push({ name, line: phone, isContact: true });
        LS.set('addresses', addresses); renderAddresses();
        speakReply(`Saved contact ${name}: ${phone}`);
        return;
      }
      // save address
      const addrMatch = cmd.match(/save address\s+(\w+)\s+(.+)/);
      if (addrMatch) {
        const name = addrMatch[1];
        const line = addrMatch[2];
        addresses.push({ name, line });
        LS.set('addresses', addresses); renderAddresses();
        speakReply(`Address saved for ${name}.`);
        return;
      }
      // directions
      const dirMatch = cmd.match(/directions to\s+(\w+)/);
      if (dirMatch) {
        const name = dirMatch[1];
        const addr = addresses.find(a => a.name.toLowerCase() === name.toLowerCase());
        if (addr) {
          window.open('https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(addr.line), '_blank');
          speakReply(`Opening directions to ${name}.`);
        } else {
          speakReply(`I don't have an address saved as ${name}.`);
        }
        return;
      }
      // whatsapp
      const waMatch = cmd.match(/whatsapp\s+(\w+)\s+saying\s+(.+)/);
      if (waMatch) {
        const name = waMatch[1];
        const msg = waMatch[2];
        const contact = addresses.find(a => a.name.toLowerCase() === name.toLowerCase() && a.isContact);
        if (contact) {
          window.open(`https://wa.me/${contact.line}?text=${encodeURIComponent(msg)}`, '_blank');
          speakReply(`Opening WhatsApp chat with ${name}. You press send yourself.`);
        } else {
          speakReply(`I don't have a contact saved as ${name}.`);
        }
        return;
      }
      // order pizza
      if (cmd.includes('order pizza from swiggy')) {
        window.open('https://www.swiggy.com/search?query=pizza', '_blank');
        speakReply('Opening Swiggy search for pizza.');
        return;
      }
      if (cmd.includes('order pizza from zomato')) {
        window.open('https://www.zomato.com/search?q=pizza', '_blank');
        speakReply('Opening Zomato search for pizza.');
        return;
      }
      // play on youtube
      const ytMatch = cmd.match(/play\s+(.+)\s+on youtube/);
      if (ytMatch) {
        window.open('https://www.youtube.com/results?search_query=' + encodeURIComponent(ytMatch[1]), '_blank');
        speakReply(`Searching YouTube for ${ytMatch[1]}.`);
        return;
      }
      // default
      speakReply('I heard: "' + raw + '". Try commands like "open music", "set a timer 5 minutes", or "remember that I like mornings".');
    }

    // ---------- HANDS-FREE CONTINUOUS ----------
    let continuousRec = null;
    function startContinuousRecognition() {
      if (continuousRec) return;
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) return;
      continuousRec = new SR();
      continuousRec.lang = 'en-IN';
      continuousRec.continuous = true;
      continuousRec.interimResults = false;
      continuousRec.onresult = (e) => {
        const text = e.results[e.results.length - 1][0].transcript;
        appendConv('user', text);
        handleCommand(text);
      };
      continuousRec.onerror = () => { continuousRec = null; };
      continuousRec.onend = () => {
        if (handsFree) setTimeout(() => startContinuousRecognition(), 500);
        else continuousRec = null;
      };
      continuousRec.start();
    }

    // ============================================================
    //  SMALL FLOATING ORB (non-Maya pages)
    // ============================================================
    const smallOrb = document.getElementById('smallOrb');
    let smallDrag = false, sx, sy, ox, oy;
    smallOrb.addEventListener('pointerdown', (e) => {
      smallDrag = true;
      sx = e.clientX; sy = e.clientY;
      const r = smallOrb.getBoundingClientRect();
      ox = r.left; oy = r.top;
      smallOrb.setPointerCapture(e.pointerId);
    });
    smallOrb.addEventListener('pointermove', (e) => {
      if (!smallDrag) return;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      smallOrb.style.right = 'auto';
      smallOrb.style.bottom = 'auto';
      smallOrb.style.left = (ox + dx) + 'px';
      smallOrb.style.top = (oy + dy) + 'px';
    });
    smallOrb.addEventListener('pointerup', () => { smallDrag = false; });
    smallOrb.addEventListener('click', () => {
      const cap = document.getElementById('orbCaption');
      cap.textContent = 'Tap the Maya page to talk to me.';
      cap.classList.add('show');
      setTimeout(() => cap.classList.remove('show'), 2500);
    });

    // resize small orb on dblclick
    smallOrb.addEventListener('dblclick', () => {
      const cur = smallOrb.offsetWidth;
      const next = cur > 120 ? 80 : 140;
      smallOrb.style.width = next + 'px';
      smallOrb.style.height = next + 'px';
    });

    // ============================================================
    //  INIT
    // ============================================================
    // show small orb on load (status page)
    document.getElementById('smallOrb').style.display = 'block';
    renderNotifPanel();

    // periodic reminder check
    setInterval(() => {
      const now = Date.now();
      reminders.forEach((r, i) => {
        if (r.ts && r.ts <= now) {
          pushNotification(`⏰ ${r.msg}`);
          reminders.splice(i, 1);
          LS.set('reminders', reminders);
          renderReminders();
        }
      });
    }, 2000);

    // phone-number detection in any text input -> show WhatsApp/Call buttons
    document.querySelectorAll('input[type="text"], textarea').forEach(inp => {
      inp.addEventListener('input', () => {
        const val = inp.value.replace(/[\s\-()]/g, '');
        let existing = inp.parentElement.querySelector('.phone-actions');
        if (/^\+?\d{10,13}$/.test(val)) {
          if (!existing) {
            const div = document.createElement('div');
            div.className = 'phone-actions';
            div.style.marginTop = '4px';
            div.innerHTML = `<a href="https://wa.me/${val.replace(/^\+/,'')}" target="_blank" class="btn btn-sm btn-gold" style="text-decoration:none;">WhatsApp</a>
              <a href="tel:${val}" class="btn btn-sm" style="text-decoration:none;margin-left:4px;">📞 Call</a>`;
            inp.parentElement.appendChild(div);
          } else {
            existing.querySelector('a[href^="https://wa.me"]').href = 'https://wa.me/' + val.replace(/^\+/,'');
            existing.querySelector('a[href^="tel:"]').href = 'tel:' + val;
          }
        } else if (existing) {
          existing.remove();
        }
      });
    });

    // warn about localStorage availability
    try {
      localStorage.setItem('maya_test', '1');
      localStorage.removeItem('maya_test');
    } catch(e) {
      alert('⚠️ This view cannot store data. localStorage is blocked. All saves will fail.');
      toast('⚠️ localStorage blocked — data cannot be saved.', 5000);
    }

    console.log('MAYA System ready.');
  </script>
</body>
</html>
