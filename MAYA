  <!-- SMALL FLOATING ORB (on non-Maya pages) -->
  <div class="orb-container" id="smallOrb" style="display:none;">
    <div class="orb-core">
      <div class="orb-dots"></div>
      <div class="orb-glow"></div>
    </div>
  </div>
  <div class="orb-caption" id="orbCaption"></div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script>
    // ============================================================
    //  MAYA SYSTEM · standalone localStorage edition
    // ============================================================

    const LS = {
      get(k, d) { try { const v = localStorage.getItem('maya_' + k); return v ? JSON.parse(v) : d; } catch(e) { return d; } },
      set(k, v) { try { localStorage.setItem('maya_' + k, JSON.stringify(v)); return true; } catch(e) { console.warn('LS save fail', e); return false; } },
      del(k) { localStorage.removeItem('maya_' + k); }
    };

    // ---------- TOAST ----------
    function toast(msg, dur = 2200) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      clearTimeout(t._timer);
      t._timer = setTimeout(() => t.classList.remove('show'), dur);
    }

    // ---------- CLOCK ----------
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      document.getElementById('liveClock').innerHTML = `${h}:${m}:<strong>${s}</strong>`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // ---------- XP / LEVEL ----------
    let xp = LS.get('xp', 0);
    let level = LS.get('level', 1);
    function updateXP() {
      const needed = level * 100;
      document.getElementById('xpFill').style.width = Math.min(100, (xp / needed) * 100) + '%';
      document.getElementById('xpText').textContent = `${xp}/${needed}`;
      document.getElementById('levelBadge').textContent = `Lv.${level}`;
      if (xp >= needed) { xp -= needed; level++; toast(`⬆️ Level up! Lv.${level}`); LS.set('xp', xp); LS.set('level', level); }
      LS.set('xp', xp);
    }
    function addXP(n) { xp += n; updateXP(); }
    updateXP();

    // ---------- NOTIFICATIONS ----------
    let notifLog = LS.get('notifLog', []);
    let notifUnread = LS.get('notifUnread', 0);
    let reminders = LS.get('reminders', []);

    function renderNotifBadge() {
      document.getElementById('bellBadge').textContent = notifUnread;
      document.getElementById('bellBadge').style.display = notifUnread > 0 ? 'grid' : 'none';
    }
    renderNotifBadge();

    function renderNotifPanel() {
      const rDiv = document.getElementById('notifReminders');
      if (reminders.length === 0) rDiv.innerHTML = '<div class="empty-msg">Nothing scheduled.</div>';
      else rDiv.innerHTML = reminders.map(r => `<div class="notif-item"><strong>${r.msg}</strong>${r.when}</div>`).join('');

      const lDiv = document.getElementById('notifLog');
      if (notifLog.length === 0) lDiv.innerHTML = '<div class="empty-msg">No notifications yet.</div>';
      else lDiv.innerHTML = notifLog.slice(-10).reverse().map(n => `<div class="notif-item"><strong>${n.msg}</strong>${n.time}</div>`).join('');

      const sDiv = document.getElementById('notifSuggestions');
      sDiv.innerHTML = `<div class="notif-item"><strong>Try saying:</strong>"Hey Maya, set a timer 5 minutes"</div>
        <div class="notif-item"><strong>Tip:</strong>Log study hours to gain XP.</div>`;
    }

    document.getElementById('bellBtn').addEventListener('click', () => {
      document.getElementById('notifPanel').classList.toggle('open');
      notifUnread = 0;
      renderNotifBadge();
      renderNotifPanel();
    });

    function pushNotification(msg) {
      notifLog.push({ msg, time: new Date().toLocaleTimeString() });
      notifLog = notifLog.slice(-50);
      LS.set('notifLog', notifLog);
      notifUnread++;
      renderNotifBadge();
      renderNotifPanel();
      toast(msg, 3000);
      // beep
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.frequency.value = 880; o.connect(g); g.connect(ctx.destination);
        g.gain.setValueAtTime(0.1, ctx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
        o.start(); o.stop(ctx.currentTime + 0.4);
      } catch(e) {}
      // speech
      if ('speechSynthesis' in window) {
        const u = new SpeechSynthesisUtterance(msg);
        u.lang = 'en-IN'; u.rate = 0.95;
        speechSynthesis.speak(u);
      }
    }

    // ---------- NAVIGATION ----------
    let currentPage = 'status';
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentPage = btn.dataset.page;
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById('page-' + currentPage).classList.add('active');
        // orb visibility
        const smallOrb = document.getElementById('smallOrb');
        const orbCaption = document.getElementById('orbCaption');
        if (currentPage === 'maya') {
          smallOrb.style.display = 'none';
          orbCaption.classList.remove('show');
        } else {
          smallOrb.style.display = 'block';
        }
      });
    });

    // ============================================================
    //  PAGE: STATUS
    // ============================================================
    const quests = [
      { id: 'q1', label: 'Log 2+ study hours' },
      { id: 'q2', label: 'Log sleep' },
      { id: 'q3', label: 'Exercise 15 min' },
      { id: 'q4', label: 'Practice calm breathing' },
      { id: 'q5', label: 'Review Amicus numbers' },
      { id: 'q6', label: 'Check reminders' },
    ];
    let questState = LS.get('questState', {});

    function renderQuests() {
      const el = document.getElementById('questList');
      el.innerHTML = quests.map(q => {
        const done = questState[q.id] ? 'checked' : '';
        return `<label style="display:flex;align-items:center;gap:8px;padding:6px 0;font-size:13px;cursor:pointer;">
          <input type="checkbox" ${done} onchange="toggleQuest('${q.id}',this.checked)" style="accent-color:var(--gold);width:16px;height:16px;" />
          <span style="${questState[q.id] ? 'text-decoration:line-through;color:var(--text-dim)' : ''}">${q.label}</span>
        </label>`;
      }).join('');
    }
    window.toggleQuest = (id, checked) => {
      questState[id] = checked;
      LS.set('questState', questState);
      renderQuests();
      if (checked) { addXP(5); toast('✅ Quest complete +5 XP'); }
    };
    renderQuests();

    window.saveIntention = () => {
      const v = document.getElementById('dailyIntention').value.trim();
      if (!v) { toast('⚠️ Please enter an intention first.'); return; }
      LS.set('intention', v);
      document.getElementById('intentionSaved').textContent = '✅ Saved: ' + v;
      addXP(3);
    };
    const savedIntention = LS.get('intention', '');
    if (savedIntention) document.getElementById('dailyIntention').value = savedIntention;

    // briefing
    (function() {
      const h = new Date().getHours();
      let greet = 'Good evening';
      if (h < 12) greet = 'Good morning';
      else if (h < 17) greet = 'Good afternoon';
      document.getElementById('briefingText').textContent = `${greet}, Uday. The System awaits your commands.`;
    })();

    // ============================================================
    //  PAGE: STUDY
    // ============================================================
    let studyLogs = LS.get('studyLogs', []);
    function renderStudy() {
      const el = document.getElementById('studyList');
      if (studyLogs.length === 0) { el.innerHTML = '<div class="empty-msg">No study logs yet.</div>'; return; }
      el.innerHTML = studyLogs.map((s, i) => `<div class="list-item"><div><strong>${s.subject}</strong><div class="meta">${s.hours}h · weak: ${s.weak || '—'}</div></div><button class="btn btn-sm btn-danger" onclick="delStudy(${i})">✕</button></div>`).join('');
    }
    window.saveStudy = () => {
      const subject = document.getElementById('studySubject').value.trim();
      const hours = parseFloat(document.getElementById('studyHours').value);
      const weak = document.getElementById('studyWeak').value.trim();
      const w = document.getElementById('studyWarn');
      if (!subject) { w.style.display = 'block'; w.textContent = '⚠️ Missing: Subject.'; return; }
      if (isNaN(hours) || hours <= 0) { w.style.display = 'block'; w.textContent = '⚠️ Missing: valid Hours.'; return; }
      w.style.display = 'none';
      studyLogs.push({ subject, hours, weak });
      LS.set('studyLogs', studyLogs);
      document.getElementById('studySubject').value = '';
      document.getElementById('studyHours').value = '';
      document.getElementById('studyWeak').value = '';
      renderStudy(); addXP(4); toast('📚 Study log saved +4 XP');
    };
    window.delStudy = (i) => { studyLogs.splice(i, 1); LS.set('studyLogs', studyLogs); renderStudy(); };
    renderStudy();

    // ============================================================
    //  PAGE: SLEEP
    // ============================================================
    let sleepLogs = LS.get('sleepLogs', []);
    function renderSleep() {
      const el = document.getElementById('sleepList');
      if (sleepLogs.length === 0) { el.innerHTML = '<div class="empty-msg">No sleep logs yet.</div>'; return; }
      el.innerHTML = sleepLogs.map((s, i) => `<div class="list-item"><div>${s.date} · <strong>${s.hours}h</strong> · quality ${s.quality}/5</div><button class="btn btn-sm btn-danger" onclick="delSleep(${i})">✕</button></div>`).join('');
    }
    window.saveSleep = () => {
      const date = document.getElementById('sleepDate').value;
      const hours = parseFloat(document.getElementById('sleepHours').value);
      const quality = parseInt(document.getElementById('sleepQuality').value);
      const w = document.getElementById('sleepWarn');
      if (!date) { w.style.display = 'block'; w.textContent = '⚠️ Missing: Date.'; return; }
      if (isNaN(hours) || hours <= 0) { w.style.display = 'block'; w.textContent = '⚠️ Missing: valid Hours.'; return; }
      w.style.display = 'none';
      sleepLogs.push({ date, hours, quality: quality || 3 });
      LS.set('sleepLogs', sleepLogs);
      document.getElementById('sleepDate').value = '';
      document.getElementById('sleepHours').value = '';
      document.getElementById('sleepQuality').value = '';
      renderSleep(); addXP(3); toast('🌙 Sleep saved +3 XP');
    };
    window.delSleep = (i) => { sleepLogs.splice(i, 1); LS.set('sleepLogs', sleepLogs); renderSleep(); };
    renderSleep();

    // ============================================================
    //  PAGE: EXERCISE
    // ============================================================
    let exLogs = LS.get('exLogs', []);
    function renderEx() {
      const el = document.getElementById('exList');
      if (exLogs.length === 0) { el.innerHTML = '<div class="empty-msg">No exercise logs yet.</div>'; return; }
      el.innerHTML = exLogs.map((e, i) => `<div class="list-item"><div><strong>${e.name}</strong><div class="meta">${e.duration} min · ${e.reps || '—'}</div></div><button class="btn btn-sm btn-danger" onclick="delEx(${i})">✕</button></div>`).join('');
    }
    window.saveExercise = () => {
      const name = document.getElementById('exSelect').value;
      const duration = parseFloat(document.getElementById('exDuration').value);
      const reps = document.getElementById('exReps').value.trim();
      const w = document.getElementById('exWarn');
      if (isNaN(duration) || duration <= 0) { w.style.display = 'block'; w.textContent = '⚠️ Missing: valid Duration.'; return; }
      w.style.display = 'none';
      exLogs.push({ name, duration, reps });
      LS.set('exLogs', exLogs);
      document.getElementById('exDuration').value = '';
      document.getElementById('exReps').value = '';
      renderEx(); addXP(4); toast('🏋️ Exercise saved +4 XP');
    };
    window.delEx = (i) => { exLogs.splice(i, 1); LS.set('exLogs', exLogs); renderEx(); };
    renderEx();

    // ============================================================
    //  PAGE: CALM
    // ============================================================
    let breathing = false;
    let breathInterval = null;
    window.toggleBreathing = () => {
      breathing = !breathing;
      const circle = document.getElementById('breathCircle');
      const status = document.getElementById('breathStatus');
      const btn = document.getElementById('breathBtn');
      if (breathing) {
        btn.textContent = '⏹ Stop';
        circle.style.transform = 'scale(1.5)';
        status.textContent = 'Inhale...';
        breathInterval = setInterval(() => {
          const t = Date.now() % 8000;
          if (t < 4000) { circle.style.transform = 'scale(1.5)'; status.textContent = 'Inhale...'; }
          else { circle.style.transform = 'scale(1)'; status.textContent = 'Exhale...'; }
        }, 200);
      } else {
        btn.textContent = 'Start Breathing';
        clearInterval(breathInterval);
        circle.style.transform = 'scale(1)';
        status.textContent = '';
      }
    };

    let angerLogs = LS.get('angerLogs', []);
    function renderAnger() {
      const el = document.getElementById('angerList');
      if (angerLogs.length === 0) { el.innerHTML = '<div class="empty-msg">No anger logs yet.</div>'; return; }
      el.innerHTML = angerLogs.map((a, i) => `<div class="list-item"><div><strong>${a.trigger}</strong> · intensity ${a.intensity}/10</div><button class="btn btn-sm btn-danger" onclick="delAnger(${i})">✕</button></div>`).join('');
    }
    window.saveAnger = () => {
      const trigger = document.getElementById('angerTrigger').value.trim();
      const intensity = parseInt(document.getElementById('angerIntensity').value);
      const w = document.getElementById('angerWarn');
      if (!trigger) { w.style.display = 'block'; w.textContent = '⚠️ Missing: Trigger.'; return; }
      if (isNaN(intensity) || intensity < 1 || intensity > 10) { w.style.display = 'block'; w.textContent = '⚠️ Missing: Intensity (1-10).'; return; }
      w.style.display = 'none';
      angerLogs.push({ trigger, intensity });
      LS.set('angerLogs', angerLogs);
      document.getElementById('angerTrigger').value = '';
